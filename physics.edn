;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a robot may perform the physical work of a
;; sporting-goods store (ISIC 4763) -- shelfing, picking, restocking. Here:
;; an arm hanging weight plates back on the plate tree in the fitness
;; section, and a powered dolly bringing a boxed treadmill in over the
;; store-entrance ramp.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-4763"
 :cases
 [{:id :weight-plate-to-plate-tree
   :kind :manipulator
   :procedure "arm picks a weight plate from the floor display and hangs it on the upper peg of the plate tree"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 6.0 :m2-kg 4.0
            :from [0.60 -0.30] :to [0.45 0.40] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [2.5 5.0 10.0 15.0 20.0 25.0]}
   :quantity :peak-tau1-nm
   :limit {:max 180.0 :basis "estimate: continuous shoulder torque of a ~15 kg-payload collaborative arm"}
   :boundary {:lo 0.5 :hi 60.0}}
  {:id :treadmill-dolly-entrance-ramp
   :kind :transport
   :procedure "powered dolly carries a boxed 130 kg treadmill from the kerb up the 6 m store-entrance ramp"
   :params {:mass-kg 45.0 :payload-kg 130.0 :distance-m 6.0 :v-max-mps 0.6 :a-max-mps2 0.3
            :brake-decel-mps2 0.8 :drive-force-n 300.0 :crr 0.02
            :cog-height-m 0.30 :payload-cog-height-m 0.45
            :support-half-length-m 0.45 :max-time-s 600.0}
   :sweep {:param :slope-deg :values [0.0 3.0 6.0 8.0 9.0 10.0]}
   :quantity :cycle-time-s
   :limit {:max 25.0 :basis "estimate: the ramp leg should clear within ~25 s so the entrance is not blocked; a stall is out of tolerance"}
   :boundary {:lo 0.0 :hi 15.0}}]}
